.story p{color:#444;font-size:15.5px;margin-bottom:16px}
.sv{background:var(--k);border-radius:14px}
.skg{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.sk{display:flex;align-items:center;gap:14px;padding:16px 18px;border:1px solid var(--g2);border-radius:14px;background:var(--w);font-weight:600;font-size:14.5px;line-height:1.35;transition:.3s}
.sk i{display:grid;place-items:center;flex:none;width:44px;height:44px;border-radius:12px;background:var(--g1);transition:.3s}
.sk svg{width:22px;height:22px;stroke:var(--k);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.sk:hover{border-color:var(--y);transform:translateY(-3px);box-shadow:0 0 0 1px var(--y)}.sk:hover i{background:var(--y)}
.tpg{display:flex;flex-wrap:wrap;justify-content:center;gap:12px}.tpg .tp{margin:0}
.tpg .tp:hover i{background:var(--y);color:var(--k);filter:none}
.ap{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;position:relative}
.ap:before{content:"";position:absolute;top:24px;left:10%;right:10%;height:1px;background:#444}
.st{text-align:center}
.st .n{display:grid;place-items:center;width:48px;height:48px;margin:0 auto 16px;border-radius:50%;background:var(--k);border:1px solid var(--y);position:relative;z-index:1;transition:.3s}
.st .n svg{width:20px;height:20px;stroke:var(--y);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.st:hover .n{background:var(--y)}.st:hover .n svg{stroke:var(--k)}
.st h3{font-size:17px;margin-bottom:6px}.st p{font-size:13.5px;color:#bdbdbd}
.tm.lt:before{background:#d6d6d6}
.tm.lt .it p{color:#555}.tm.lt .it .d{color:#6b6b6b}
.tm.lt .it .ic{background:var(--w);color:var(--k);border-color:var(--k)}
.tm.lt .it:hover .ic{background:var(--y);border-color:var(--y)}
.ed .it{padding-bottom:30px}.ed .it:last-child{padding-bottom:0}.ed .tm:before{bottom:20px}
.fq{display:grid;gap:12px}
.fi{border:1px solid var(--g2);border-radius:14px;background:var(--w);transition:.3s}
.fi.open{border-color:var(--y);box-shadow:0 0 0 1px var(--y)}
.fi button{all:unset;box-sizing:border-box;width:100%;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 22px;cursor:pointer;font:600 16px/1.4 "Inter Tight",Inter,sans-serif;color:var(--k)}
.fi button:focus-visible{outline:2px solid var(--y);outline-offset:2px}
.pm{position:relative;flex:none;width:30px;height:30px;border-radius:50%;background:var(--k)}
.pm:before,.pm:after{content:"";position:absolute;background:var(--y)}
.pm:before{left:9px;top:14px;width:12px;height:2px}
.pm:after{left:14px;top:9px;width:2px;height:12px;transition:transform .3s}
.fi.open .pm:after{transform:scaleY(0)}
.fa{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s ease}.fi.open .fa{grid-template-rows:1fr}
.fa>div{overflow:hidden}.fa p{padding:0 22px 20px;color:#555;font-size:14.5px}
.cta{text-align:center}.cta .sh{margin:0 auto 28px}
.faq .wrap{max-width:820px}.faq .sh{max-width:none;margin:0 auto 36px;text-align:center}.faq .sh p{max-width:600px;margin:0 auto}.faq .eyebrow{justify-content:center}
@media(max-width:900px){.ah .wrap,.two .wrap{grid-template-columns:1fr;gap:36px}.skg{grid-template-columns:repeat(2,1fr)}
.ap{grid-template-columns:1fr;gap:26px}.ap:before{left:23px;right:auto;top:24px;bottom:24px;width:1px;height:auto}
.st{display:grid;grid-template-columns:48px 1fr;column-gap:16px;text-align:left}.st .n{grid-row:1/3;margin:0}}
@media(max-width:480px){.skg{grid-template-columns:1fr}}

.sp{border:1px solid #2a2a2a;border-top:3px solid var(--y);border-radius:14px;padding:22px;background:#111}
.sb{display:flex;align-items:center;gap:10px;border:1px solid #333;border-radius:999px;padding:10px 16px;margin-bottom:16px;color:#8a8a8a;font-size:13px}
.sb svg{width:16px;height:16px;stroke:var(--y);fill:none;stroke-width:2;stroke-linecap:round}
.r{display:grid;gap:7px;padding:14px;margin-bottom:8px;border:1px solid transparent;border-radius:10px;animation:up .8s both}
.r:nth-child(3){animation-delay:.15s}.r:nth-child(4){animation-delay:.3s}
.r b{display:block;height:9px;width:55%;background:#444;border-radius:5px}
.r s{display:block;height:6px;width:92%;background:#2a2a2a;border-radius:4px}.r s+s{width:70%}
.r.top{border-color:var(--y);background:#1a1a1a}.r.top b{background:var(--y)}
@keyframes up{from{opacity:0;transform:translateY(14px)}}
.sh.sub{margin-top:56px}
.sec-c .sh{max-width:none}
.sw .wrap{display:grid;grid-template-columns:1fr 1.15fr;gap:56px;align-items:center}.sw .sh{margin:0;max-width:none}
.cmp{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.cp{border-radius:14px;padding:26px;border:1px solid var(--g2);background:var(--w)}
.cp h3{font-size:16px;margin-bottom:18px}
.cp ul{list-style:none;padding:0;display:grid;gap:14px;font-size:14px}
.cp li{display:flex;gap:10px;align-items:flex-start;line-height:1.45}
.cp li:before{content:"✕";flex:none;display:grid;place-items:center;width:20px;height:20px;border-radius:50%;background:var(--g1);color:#8a8a8a;font-size:10px}
.cp.mut{color:#777}
.cp.str{background:var(--k);color:var(--w);border-color:var(--k);border-top:3px solid var(--y)}
.cp.str li:before{content:"✓";background:var(--y);color:var(--k);font-weight:700}
@media(max-width:900px){.sw .wrap{grid-template-columns:1fr;gap:32px}}
@media(max-width:520px){.cmp{grid-template-columns:1fr}}
.wi2{display:grid;grid-template-columns:repeat(3,1fr);gap:32px 28px}
.it2{border-top:2px solid var(--k);padding-top:22px;transition:border-color .3s}
.it2:hover{border-top-color:var(--y)}
.it2 i{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:var(--y);margin-bottom:16px;transition:transform .3s}
.it2:hover i{transform:translateY(-3px)}
.it2 svg{width:20px;height:20px;stroke:var(--k);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.it2 h3{font-size:17px;font-weight:600;margin-bottom:8px}.it2 p{font-size:14px;color:#555}
