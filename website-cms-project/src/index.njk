---
pagekey: home
permalink: /index.html
---
{% set p = pc[pagekey] %}
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ p.meta_title }}</title>
<meta name="description" content="{{ p.meta_description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ p.meta_title }}"><meta property="og:description" content="{{ p.meta_description }}"><meta property="og:type" content="website"><meta property="og:url" content="{{ site.url }}{{ page.url }}">{% if site.og_image %}<meta property="og:image" content="{{ site.url }}{{ site.og_image }}">{% endif %}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{--k:#000;--w:#fff;--g1:#f4f4f4;--g2:#e2e2e2;--g3:#8a8a8a;--g4:#1a1a1a;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-behavior:smooth;scroll-padding-top:72px}
*{box-sizing:border-box;margin:0}
body{font-family:Inter,system-ui,sans-serif;background:var(--w);color:var(--k);line-height:1.6;-webkit-font-smoothing:antialiased}
h1,h2,h3,.logo{font-family:"Inter Tight",Inter,system-ui,sans-serif;letter-spacing:-.02em;line-height:1.1}
a{color:inherit;text-decoration:none}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
nav{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--g2)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px}
.logo{display:grid;place-items:center;width:40px;height:40px;border:1.5px solid var(--k);font-weight:700;font-size:14px;letter-spacing:0;transition:.25s}
.logo:hover{background:var(--k);color:var(--w)}
.links{display:flex;gap:20px;font-size:13px;color:#444}
.links a{position:relative;padding:4px 0}
.links a:after{content:"";position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--k);transition:.25s}
.links a:hover:after{width:100%}.links a:hover{color:var(--k)}
.btn{display:inline-block;background:var(--k);color:var(--w);border:1px solid var(--k);padding:11px 22px;font-size:14px;font-weight:500;border-radius:999px;transition:.25s}
.btn:hover{background:var(--w);color:var(--k);transform:translateY(-2px)}
nav .btn{padding:8px 16px;font-size:13px}
.burger{display:none;background:none;border:0;font-size:22px;cursor:pointer}
section{padding:96px 0}
.hero{background:var(--k);color:var(--w);padding:88px 0}
.hero .wrap{display:grid;grid-template-columns:1.25fr 1fr;gap:48px;align-items:center}
.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--g3);margin-bottom:16px}
.hero h1{font-size:clamp(36px,5.4vw,64px);font-weight:700;margin-bottom:22px}
.hero p{color:#bdbdbd;max-width:520px;margin-bottom:30px}
.hero .btn{background:var(--w);color:var(--k);border-color:var(--w)}
.hero .btn:hover{background:transparent;color:var(--w)}
.viz{border:1px solid #333;padding:24px;border-radius:4px}
.viz svg{width:100%;height:auto;display:block}
.bar{fill:#fff;transform-origin:bottom;transform-box:fill-box;animation:grow 1.2s cubic-bezier(.2,.8,.2,1) both}
.line{stroke:#fff;stroke-width:2;fill:none;stroke-dasharray:400;animation:draw 2s .5s ease forwards;stroke-dashoffset:400}
@keyframes grow{from{transform:scaleY(0)}}@keyframes draw{to{stroke-dashoffset:0}}
.sh{max-width:640px;margin-bottom:40px}
.sh h2{font-size:clamp(28px,3.6vw,42px);margin-bottom:10px}
.sh h3{font-size:18px;font-weight:500;color:#444;margin-bottom:12px;letter-spacing:-.01em}
.sh p{color:#555;font-size:15px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.card{border:1px solid var(--g2);padding:24px;border-radius:4px;transition:.3s;background:var(--w)}
.card:hover{background:var(--k);color:var(--w);transform:translateY(-4px);border-color:var(--k)}
.card svg{width:28px;height:28px;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;margin-bottom:18px}
.card h3{font-size:17px;margin-bottom:8px}
.card p{font-size:13.5px;color:var(--g3);transition:.3s}.card:hover p{color:#bdbdbd}
.alt{background:var(--g1)}
.tech{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.tool{background:var(--w);border:1px solid var(--g2);border-radius:4px;padding:18px 8px;text-align:center;font-size:12px;color:#444;transition:.3s}
.tool i{display:grid;place-items:center;width:40px;height:40px;margin:0 auto 10px;border-radius:10px;font:700 17px "Inter Tight",sans-serif;font-style:normal;color:#fff;background:var(--c);filter:grayscale(1) contrast(.9);transition:.3s}
.tool:hover{transform:translateY(-3px)}
.tool:hover i{filter:none;transform:scale(1.15)}
.tl{position:relative;max-width:680px;padding-left:32px;border-left:1px solid var(--k)}
.tl div{position:relative;padding-bottom:32px}
.tl div:before{content:"";position:absolute;left:-38px;top:6px;width:11px;height:11px;background:var(--w);border:2px solid var(--k);border-radius:50%;transition:.3s}
.tl div:hover:before{background:var(--k)}
.tl h3{font-size:19px}.tl span{font-size:13px;color:var(--g3)}
.pill{display:inline-block;border:1px solid var(--g2);border-radius:999px;padding:8px 16px;margin:0 8px 8px 0;font-size:14px;transition:.25s;background:var(--w)}
.pill:hover{background:var(--k);color:var(--w)}
.dark{background:var(--k);color:var(--w)}.dark .sh p{color:#bdbdbd}
.dark .btn{background:var(--w);color:var(--k)}.dark .btn:hover{background:transparent;color:var(--w)}
footer{padding:24px 0;border-top:1px solid var(--g2);font-size:13px;color:var(--g3)}
.rv{opacity:0;transform:translateY(18px);transition:.7s cubic-bezier(.2,.8,.2,1)}.rv.in{opacity:1;transform:none}
@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}.tech{grid-template-columns:repeat(3,1fr)}.hero .wrap{grid-template-columns:1fr}
.burger{display:block}.links{display:none;position:absolute;top:64px;left:0;right:0;background:var(--w);flex-direction:column;padding:16px 24px;border-bottom:1px solid var(--g2);gap:12px}.links.open{display:flex}}
@media(max-width:520px){.grid{grid-template-columns:1fr}.tech{grid-template-columns:repeat(2,1fr)}nav .btn{display:none}section{padding:56px 0}}
.hero{background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:64px 64px}
.hero h1{font-weight:600;letter-spacing:-.035em}
.sh h2{font-weight:600;letter-spacing:-.03em}
.eyebrow{display:flex;align-items:center;gap:10px}.eyebrow:before{content:"";width:24px;height:1px;background:currentColor}
.btn:after{content:"→";display:inline-block;margin-left:10px;transition:transform .25s}.btn:hover:after{transform:translateX(4px)}
nav .btn:after{display:none}
.card{border-radius:14px;padding:28px;border-color:var(--g2)}
.card:hover{transform:translateY(-6px)}
.viz{border-radius:14px;border-color:#2a2a2a}
.tech{grid-template-columns:repeat(5,1fr);gap:14px}
.tool{position:relative;height:104px;display:grid;place-items:center;padding:0;border-radius:14px;overflow:hidden}
.tool i{margin:0;width:44px;height:44px;border-radius:12px;transition:transform .35s cubic-bezier(.2,.8,.2,1),filter .35s}
.tool b{position:absolute;left:0;right:0;bottom:10px;max-height:none;margin:0;opacity:0;transform:translateY(8px);font-size:11.5px;font-weight:500;color:var(--k);transition:.35s}
.tool:hover{transform:none;border-color:var(--k)}
.tool:hover i{transform:translateY(-10px) scale(1.18)}
.tool:hover b{opacity:1;transform:none;max-height:none}
.pill{border-radius:999px;padding:10px 20px}
.tl h3{font-weight:600}
.logo{width:auto;height:auto;border:0;padding:0}.logo:hover{background:none;color:inherit}.logo img{display:block;height:36px;width:auto;transition:transform .3s}.logo:hover img{transform:scale(1.08)}
.logo{display:flex;align-items:center;gap:12px}
.bn{font:500 14px "Inter Tight",Inter,sans-serif;letter-spacing:-.01em;white-space:nowrap;color:#555}.bn b{color:var(--k);font-weight:700}
.about .wrap{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}
.about .sh{max-width:none;margin:0;position:sticky;top:110px}
.about .sh h3{color:#d0d0d0}
.about .tl{max-width:none;border-left-color:#555}
.about .tl div:before{background:var(--k);border-color:var(--w)}.about .tl div:hover:before{background:var(--w)}
.about .tl p{color:#bdbdbd}.about .tl span{color:#8a8a8a}
.about .tl h3{font-size:24px}
@media(max-width:1040px){.burger{display:block}.links{display:none;position:absolute;top:64px;left:0;right:0;background:var(--w);flex-direction:column;padding:16px 24px;border-bottom:1px solid var(--g2);gap:12px}.links.open{display:flex}}
@media(max-width:900px){.about .wrap{grid-template-columns:1fr;gap:32px}.about .sh{position:static}}
@media(max-width:420px){.bn{font-size:12px}}
.tm{position:relative;max-width:520px}
.tm:before{content:"";position:absolute;left:146px;top:8px;bottom:30px;width:1px;background:#444}
.it{display:grid;grid-template-columns:120px 1fr;gap:52px;position:relative;padding-bottom:22px}
.it .d{font-size:13px;color:#8a8a8a;text-align:right;padding-top:6px}
.it .ic{position:absolute;left:131px;top:0;width:30px;height:30px;border-radius:50%;background:var(--k);border:1px solid #666;display:grid;place-items:center;transition:.3s}
.it .ic svg,.feat .ic svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.it .ic{color:var(--w)}.it:hover .ic{background:var(--w);border-color:var(--w);color:var(--k)}
.it h3{font-size:16.5px;font-weight:600;transition:.3s}.it p{font-size:14px;color:#bdbdbd}
.fg{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.feat{border:1px solid var(--g2);border-radius:14px;padding:28px;background:var(--w);transition:.3s}
.feat:hover{transform:translateY(-5px);border-color:var(--k)}
.feat .ic{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--g2);border-radius:12px;margin-bottom:18px;transition:.3s}
.feat .ic svg{width:21px;height:21px}
.feat:hover .ic{background:var(--k);color:var(--w);border-color:var(--k)}
.feat h3{font-size:17px;font-weight:600;margin-bottom:8px}.feat p{font-size:13.5px;color:#666}
@media(max-width:900px){.fg{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.fg{grid-template-columns:1fr}.tm:before{left:15px}.it{grid-template-columns:1fr;gap:4px;padding-left:46px}.it .d{text-align:left;padding-top:0}.it .ic{left:0;top:2px}}
.mq{overflow:hidden;padding:8px 0;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.mq-track{display:flex;width:max-content;animation:mq 45s linear infinite}
.mq:hover .mq-track{animation-play-state:paused}
@keyframes mq{to{transform:translateX(-50%)}}
.tp{display:flex;align-items:center;gap:10px;margin-right:14px;padding:10px 22px 10px 12px;background:var(--w);border:1px solid var(--g2);border-radius:999px;font-size:14px;font-weight:600;white-space:nowrap;transition:.3s}
.tp i{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;font:700 13px "Inter Tight",sans-serif;font-style:normal;color:#fff;background:var(--c);filter:grayscale(1);transition:.3s}
.tp:hover{border-color:var(--k);transform:translateY(-3px)}
.tp:hover i{filter:none;transform:scale(1.15)}
.ct .wrap{display:grid;grid-template-columns:1fr 1.3fr;gap:64px;align-items:start}
.ct .sh{margin:0;max-width:none}
.ct .em{margin-top:28px;font-size:15px;color:#bdbdbd}.ct .em a{color:#fff;border-bottom:1px solid #555}
.cf{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.cf .full{grid-column:1/-1}
.cf label{display:block;font-size:11.5px;color:#8a8a8a;margin-bottom:6px;letter-spacing:.08em}
.cf input,.cf select,.cf textarea{width:100%;background:transparent;border:1px solid #333;border-radius:10px;padding:13px 14px;color:#fff;font:inherit;font-size:14px;transition:.25s}
.cf textarea{min-height:130px;resize:vertical}
.cf input:focus,.cf select:focus,.cf textarea:focus{outline:0;border-color:#fff}
.cf select option{background:#000;color:#fff}
.cf button{cursor:pointer;font:inherit;font-size:14px;font-weight:500}
.cs{font-size:13px;color:#bdbdbd;margin-top:12px;min-height:20px}
footer{background:var(--k);color:#bdbdbd;border-top:1px solid #222;padding:64px 0 24px;font-size:14px}
.fw{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;gap:40px}
.fb{display:flex;align-items:center;gap:12px;color:#fff;font:600 17px "Inter Tight",Inter,sans-serif;letter-spacing:-.01em}
.fb img{height:34px;width:auto;filter:invert(1)}
footer h4{display:inline-block;min-width:120px;color:#fff;font:600 14px "Inter Tight",Inter,sans-serif;padding-bottom:12px;margin:0 0 16px;border-bottom:1px solid #444}
footer ul{list-style:none;padding:0;display:grid;gap:10px}
footer ul a{display:inline-block;transition:.25s}footer ul a:hover{color:#fff;transform:translateX(4px)}
.fs{display:flex;gap:10px;margin:20px 0}
.fs a{display:grid;place-items:center;width:36px;height:36px;border:1px solid #444;border-radius:50%;color:#fff;transition:.25s}
.fs a:hover{background:var(--w);color:var(--k)}
.fs svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
footer .btn{background:var(--w);color:var(--k);border-color:var(--w)}footer .btn:hover{background:transparent;color:var(--w)}
.fbot{margin-top:48px;padding-top:20px;border-top:1px solid #222;font-size:13px;color:#8a8a8a;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
@media(max-width:900px){.ct .wrap{grid-template-columns:1fr;gap:32px}.fw{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.cf{grid-template-columns:1fr}.fw{grid-template-columns:1fr}}
.wy{display:grid;grid-template-columns:1.4fr 1fr;gap:48px;align-items:start}
.wl .sh{max-width:none}
.wl .fg{grid-template-columns:repeat(2,1fr)}
.wi{margin:0;aspect-ratio:4/5;border-radius:20px;overflow:hidden;border:1px solid var(--g2);box-shadow:0 12px 32px rgba(0,0,0,.08)}
.wi img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .6s cubic-bezier(.2,.8,.2,1)}
.wi:hover img{transform:scale(1.03)}
@media(max-width:900px){.wy{grid-template-columns:1fr;gap:32px}.wi{position:static;max-width:480px;width:100%;margin:0 auto}}
@media(max-width:520px){.wl .fg{grid-template-columns:1fr}}
/* ===== Yellow / Black / White theme ===== */
:root{--y:#FFD20A}
::selection{background:var(--y);color:#000}
.logo img{height:44px}
.fb img{height:54px;filter:none}
.links a:after{height:2px;background:var(--y)}
.btn,.hero .btn,.dark .btn,footer .btn{background:var(--y);color:var(--k);border-color:var(--y);font-weight:600}
.btn:hover{background:var(--k);color:var(--y);border-color:var(--k)}
.hero .btn:hover,.dark .btn:hover,footer .btn:hover{background:transparent;color:var(--y);border-color:var(--y)}
.hero h1 em{font-style:normal;color:var(--y)}
.eyebrow{color:#555;font-weight:500}
.eyebrow:before{width:28px;height:3px;border-radius:2px;background:var(--y)}
.hero .eyebrow,.dark .eyebrow{color:var(--y)}
.bar{fill:var(--y);opacity:.9}.bar:nth-child(odd){opacity:.35}
.line{stroke:var(--y);stroke-width:2.5}
.viz circle{fill:var(--y)}
.viz{border-top:3px solid var(--y)}
.alt{background:#f7f6f1}
.card{position:relative;overflow:hidden}
.card:before{content:"";position:absolute;left:0;top:0;height:3px;width:0;background:var(--y);transition:width .4s}
.card:hover{border-color:var(--k)}.card:hover:before{width:100%}
.card:hover svg{stroke:var(--y)}
.tp:hover{border-color:var(--y);box-shadow:0 0 0 3px rgba(255,210,10,.3)}
.pill:hover{background:var(--y);color:var(--k);border-color:var(--y)}
.tm:before{background:#3a3a3a}
.it .d{color:var(--y)}
.it .ic{border-color:var(--y);color:var(--y)}
.it:hover .ic{background:var(--y);border-color:var(--y);color:var(--k)}
.feat:hover{border-color:var(--y);box-shadow:0 0 0 1px var(--y)}
.feat:hover .ic{background:var(--y);border-color:var(--y);color:var(--k)}
.wi{box-shadow:10px 10px 0 var(--y);border-color:var(--k)}
.cf input:focus,.cf select:focus,.cf textarea:focus{border-color:var(--y)}
.ct .em a{border-bottom-color:var(--y)}
footer{border-top:3px solid var(--y)}
footer h4{border-bottom-color:var(--y)}
footer ul a:hover{color:var(--y)}
.fs a:hover{background:var(--y);border-color:var(--y);color:var(--k)}
@media(max-width:900px){.wi{box-shadow:6px 6px 0 var(--y)}}
@media(max-width:520px){.logo img{height:34px}}
.wy{align-items:stretch}
.wi{position:relative;aspect-ratio:auto;min-height:380px}
.wi img{position:absolute;inset:0;object-position:62% center}
@media(max-width:900px){.wi{aspect-ratio:4/5;min-height:0}.wi img{object-position:center}}
.dd{position:relative}
.ddb{display:flex;align-items:center;gap:4px;background:none;border:0;font:inherit;color:inherit;cursor:pointer;padding:4px 0}
.ddb:hover{color:var(--k)}
.ddb svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform .25s}
.dd:hover .ddb svg,.dd.open .ddb svg{transform:rotate(180deg)}
.ddm{position:absolute;top:100%;left:-14px;margin-top:12px;min-width:170px;display:grid;gap:2px;padding:8px;background:var(--w);border:1px solid var(--g2);border-radius:12px;box-shadow:0 12px 28px rgba(0,0,0,.08);opacity:0;visibility:hidden;transform:translateY(6px);transition:.2s}
.ddm:before{content:"";position:absolute;left:0;right:0;top:-14px;height:14px}
.dd:hover .ddm,.dd:focus-within .ddm,.dd.open .ddm{opacity:1;visibility:visible;transform:none}
.ddm a{padding:9px 12px;border-radius:8px;font-size:13.5px}.ddm a:after{display:none}
.ddm a:hover{background:var(--y);color:var(--k)}
@media(max-width:1040px){.ddm{position:static;display:none;opacity:1;visibility:visible;transform:none;margin:0;padding:4px 0 0 12px;border:0;box-shadow:none;min-width:0}.ddm:before{display:none}.dd.open .ddm{display:grid}.dd:focus-within .ddm,.dd:hover .ddm{display:none}.dd.open:hover .ddm,.dd.open:focus-within .ddm{display:grid}}
@media(min-width:901px){.about .sh{position:sticky;top:110px;align-self:start}.about .it{padding-bottom:84px}.about .it:last-child{padding-bottom:0}.about .tm:before{bottom:36px}}
.card{display:flex;flex-direction:column}.card p{flex:1}
.card .more{display:flex;align-items:center;justify-content:space-between;margin-top:22px;padding-top:16px;border-top:1px solid var(--g2);font-size:13px;font-weight:600;letter-spacing:.01em;color:inherit;transition:border-color .3s}
.card:hover .more{border-top-color:#333}
.more span{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--y);color:var(--k);font-size:14px;line-height:1;transition:transform .25s}
.more:hover span{transform:translateX(4px)}
.pf .pfh{max-width:760px;margin:0 auto 48px;text-align:center}.pf .pfh .eyebrow{justify-content:center}
.pf .pfh h2{font-size:clamp(26px,3.4vw,40px)}.pf .pfh p{color:#bdbdbd;margin-top:12px}
.nj{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:24px}
.nj span{border:1px solid #333;border-radius:999px;padding:6px 14px;font-size:12.5px;color:#8a8a8a}
.nj b{background:var(--y);color:var(--k);border-radius:999px;padding:6px 14px;font-size:12.5px;font-weight:600}
.pfw{position:relative;padding-top:34px}
.loop{position:absolute;top:0;left:10%;right:10%;height:34px;border:1px dashed #555;border-bottom:0;border-radius:18px 18px 0 0}
.loop:before{content:"";position:absolute;left:-6px;bottom:-3px;border:5px solid transparent;border-top:8px solid var(--y)}
.loop span{position:absolute;left:50%;top:-11px;transform:translateX(-50%);background:var(--k);padding:0 14px;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--y);white-space:nowrap}
.pfg{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;position:relative}
.pfg:before{content:"";position:absolute;top:24px;left:10%;right:10%;height:1px;background:#444}
.pfs{text-align:center;transition-delay:calc(var(--i)*.09s)}
.pn{display:grid;place-items:center;width:48px;height:48px;margin:0 auto 14px;border-radius:50%;background:var(--k);border:1px solid #555;position:relative;z-index:1;transition:.3s}
.pn svg{width:20px;height:20px;stroke:var(--w);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;transition:.3s}
.pfs small{display:block;color:var(--y);font-size:11px;letter-spacing:.14em;margin-bottom:4px}
.pfs h3{font-size:16.5px;margin-bottom:6px}.pfs p{font-size:13px;color:#bdbdbd}
.pfs:hover .pn{border-color:var(--y);transform:translateY(-3px)}.pfs:hover .pn svg{stroke:var(--y)}
.pfs.last .pn{background:var(--y);border-color:var(--y);box-shadow:0 0 0 6px rgba(250,204,21,.18)}
.pfs.last .pn svg{stroke:var(--k)}.pfs.last h3{color:var(--y)}
.pfs.last:hover .pn svg{stroke:var(--k)}
@media(max-width:900px){.pfw{display:flex;flex-direction:column;padding-top:0}.pfg{grid-template-columns:1fr;gap:26px}
.pfg:before{left:23px;right:auto;top:24px;bottom:24px;width:1px;height:auto}
.pfs{display:grid;grid-template-columns:48px 1fr;column-gap:16px;text-align:left}.pn{grid-row:1/4;margin:0}
.loop{order:2;position:static;height:auto;border:0;margin-top:28px;text-align:center}.loop:before{display:none}
.loop span{position:static;transform:none;display:inline-block;border:1px solid var(--y);border-radius:999px;padding:7px 16px;white-space:normal}}
.sub .subb{all:unset;box-sizing:border-box;width:100%;display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 12px;border-radius:8px;font-size:13.5px;cursor:pointer;color:inherit}
.sub .subb:hover,.sub.open .subb{background:var(--g1);color:var(--k)}
.sub .subb:focus-visible{outline:2px solid var(--y)}
.sub .subb svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform .25s}
.sub.open .subb svg{transform:rotate(180deg)}
.subm{display:none;gap:2px;padding:2px 0 4px 12px}.sub.open .subm{display:grid}
@media(prefers-reduced-motion:reduce){.mq{overflow-x:auto;-webkit-mask-image:none;mask-image:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}.line{stroke-dashoffset:0}}
</style><link rel="stylesheet" href="/css/blog.css"></head><body>
{% include "nav.njk" %}

<header class="hero" id="home"><div class="wrap">
<div><div class="eyebrow">{{ p.hero_label }}</div>
